# Mã cửa hàng (tenant code) của storefront, khớp GET /public/t/{code}
VITE_SHOP_CODE=demo
# Đích proxy /public/** khi chạy dev: customer-api 8088 (dev-start.ps1 không bật nginx) hoặc nginx http://localhost:8080
VITE_API_TARGET=http://localhost:8088
# Production: đặt URL gốc của customer-api (qua nginx) nếu FE khác origin, ví dụ https://api.example.vn
VITE_API_BASE=
